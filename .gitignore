input/*
!input/.gitkeep
character-reference/*
!character-reference/.gitkeep
output/*
!output/.gitkeep
jobs/*
!jobs/.gitkeep
# login module: never commit real cookies/accounts
login/accounts*.json
login/cookies.txt
login/cookies.json
# gateway mode: never commit real accounts/settings/cache
gateway_config/
cache/
.env
__pycache__/
*.pyc
